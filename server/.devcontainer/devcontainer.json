{
  "name": "SANITENERGIE PDF Server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install && npx playwright install chromium",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SANITENERGIE App",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright"
  }
}
